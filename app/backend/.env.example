APP_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=tib_tekhnologiya
# Set a fresh random secret of at least 32 characters through the deployment secret manager.
ADMIN_TOKEN=
SESSION_TTL_SECONDS=1800
CORS_ORIGINS=https://medtech.tj,https://www.medtech.tj,http://localhost:3100,http://localhost:5173
SITE_URL=https://medtech.tj
# Required in production for shared rate limits across replicas.
REDIS_URL=
# Enable when public requests reach this service through frontend/server.js.
FRONTEND_PROXY=true
# Generate one random value (32+ characters) and set the identical secret in
# frontend and backend deployment secret stores. Never commit the value.
PROXY_SHARED_SECRET=
CLOUDINARY_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
